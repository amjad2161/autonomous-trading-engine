# =============================================================================
# FRONTEND ENV (.env)  —  copy to .env and fill in. NEVER commit the real .env.
# These VITE_* values are bundled into the public client build, so treat them as
# PUBLIC. Do NOT put any Gate.io key, secret, or private key here.
# =============================================================================

# Supabase project (the publishable/anon key is public by design)
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Shared secret that authenticates calls to privileged edge functions.
# Must match FUNCTION_SHARED_SECRET on the server (see below). Caveat: a value
# shipped in a public SPA is not a true secret — it stops anonymous scanners but
# is not a substitute for real auth. See docs/SECURITY-AND-ROADMAP.md.
VITE_FUNCTION_SECRET=

# =============================================================================
# SERVER-SIDE SECRETS  —  DO NOT put these in this file or any committed file.
# Set them with the Supabase CLI / dashboard:  supabase secrets set NAME=value
# Listed here for documentation only.
# =============================================================================
#
# GATE_API_KEY            Gate.io API key  — LEAST PRIVILEGE: spot + read only.
# GATE_API_SECRET         Gate.io API secret. NO Withdraw / Transfer / Subaccount.
#                         IP-restrict the key to your server.
#
# FUNCTION_SHARED_SECRET  Long random string; must equal VITE_FUNCTION_SECRET.
#
# --- Safety layer (supabase/functions/_shared/safety.ts) ---
# TRADING_MODE            DRY_RUN (default) | LIVE.  Leave unset / DRY_RUN until a
#                         backtest + paper forward-test pass. LIVE sends real orders.
# KILL_SWITCH             1 to block ALL live orders immediately (panic button).
# MAX_TRADE_USDT          Per-order notional cap (default 25).
# MAX_DAILY_LOSS_USDT     Daily realised-loss halt (default 20).
# MAX_OPEN_POSITIONS      Max simultaneous positions (default 3).
# MAX_TRADES_PER_HOUR     New-order throttle (default 12).
# MIN_EQUITY_USDT         Block new entries below this equity (default 0).
